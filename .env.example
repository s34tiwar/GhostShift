# Shared API, worker, and factory database settings
MONGODB_URI=mongodb+srv://<user>:<password>@<hackathon-atlas-host>/
MONGODB_DB=ghostshift_hackathon
FACTORY_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
DEMO_TOKEN=replace-with-a-demo-token

# Factory-only settings (factory state lives in MongoDB; no volume needed)
FACTORY_COLLECTION=factory_machines
FACTORY_TOKEN=
# Factory tests (real MongoDB; throwaway collections in ghostshift_factory_tests)
TEST_MONGODB_URI=mongodb+srv://<user>:<password>@<hackathon-atlas-host>/

# Worker-only settings
OPENAI_API_KEY=replace-with-an-openai-key
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_INDEX_NAME=recovery_vector_index

# Frontend setting
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
