# Shared API, worker, and factory database settings
MONGODB_URI=mongodb+srv://<user>:<password>@<hackathon-atlas-host>/
MONGODB_DB=ghostshift
FACTORY_BASE_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
DEMO_TOKEN=replace-with-a-demo-token

# Worker-only settings
GEMINI_API_KEY=replace-with-a-gemini-key
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2
VECTOR_INDEX_NAME=recovery_vector_index

# Frontend setting
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
